{
  "name": "bookshelf-graphql",
  "version": "1.0.0",
  "description": "A GraphQL API for tracking books, authors, and reading progress. Built with Apollo Server, TypeScript, and JWT auth.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "cross-env NODE_OPTIONS=--experimental-sqlite node dist/index.js",
    "dev": "cross-env NODE_OPTIONS=--experimental-sqlite ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "cross-env NODE_OPTIONS=--experimental-sqlite jest --runInBand"
  },
  "author": "Muhammad Aoun Shabbir <https://github.com/m-aoun>",
  "license": "MIT",
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "bcryptjs": "^2.4.3",
    "dataloader": "^2.2.3",
    "dotenv": "^16.4.5",
    "graphql": "^16.9.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
